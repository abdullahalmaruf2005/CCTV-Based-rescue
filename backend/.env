# AI CCTV Surveillance System - Backend Configuration

# Video source: 0 = first webcam, 1 = second webcam, or RTSP/HTTP URL
# Examples:
#   VIDEO_SOURCE=0                          # Local webcam
#   VIDEO_SOURCE=rtsp://192.168.1.100/stream  # IP camera
#   VIDEO_SOURCE=test_video.mp4             # Video file for testing
VIDEO_SOURCE=0

# Fire detection model path (after training)
# FIRE_MODEL_PATH=models/fire_best.pt

# Fire detection confidence threshold (0.0 - 1.0)
FIRE_CONFIDENCE_THRESHOLD=0.6

# Fall detection settings
FALL_DURATION_THRESHOLD=1.5
FALL_ASPECT_RATIO=1.2
MIN_PERSON_AREA=5000

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
